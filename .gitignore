# OS
.DS_Store

# Editors / IDE tooling
.idea
.fleet
.vscode

# Junie
.junie

# Node dependencies (per-package .gitignore also covers subtrees)
node_modules

# Logs
*.log

# Local env files. The two *.example files are templates and MUST stay
# value-free — real keys belong only in the untracked .env / .env.production.
.env
.env.*
!.env.example
!.env.production.example

# Claude Code workspace — skills (fwa-design is a symlink into brand/), worktrees.
# Local tooling, not part of the product.
.claude/

# Instagram kit and rendered posts — marketing collateral, not product source.
social/

# Playwright MCP session artifacts (screenshots, snapshots, console logs)
.playwright-mcp

# Marketing website — its own git repo, tracked separately (see website/CLAUDE.md)
website/

# Brand strategy — internal positioning and price posture. Local-only; the rest of
# brand/ (logos, tokens, system spec, voice guide) is public and intended to be.
brand/rebrand/strategy/
