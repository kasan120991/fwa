# SUPERSEDED 2026-07-30: these vhosts are now COMMITTED in the website repo
# (website/deploy/Caddyfile) — the single source of truth for the front door.
# Do NOT append this file on the server anymore; a website rsync + reload once
# clobbered a server-side append and took app+portal down. Kept for reference.

# Ops app routing. Append this block to the marketing site's Caddyfile
# (/opt/website/deploy/Caddyfile) on the server, then reload Caddy:
#   docker compose -f /opt/website/docker-compose.yml exec caddy \
#     caddy reload --config /etc/caddy/Caddyfile
#
# `api` and `app` resolve on the shared website_default network (the ops
# stack attaches to it as the `proxy` network). Same-origin: the SPA and API
# share app.franciswebagency.com, so the session cookie + websockets just work.

app.franciswebagency.com {
	encode zstd gzip
	@ops path /api/* /socket.io/* /uploads/*
	reverse_proxy @ops api:4000
	reverse_proxy app:3000
}

# Client portal. Same shared `api` container, same same-origin routing — the
# portal SPA and the API share portal.franciswebagency.com so the session
# cookie + websockets work with no CORS.
portal.franciswebagency.com {
	encode zstd gzip
	@api path /api/* /socket.io/* /uploads/*
	reverse_proxy @api api:4000
	reverse_proxy portal:3000
}
