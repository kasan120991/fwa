# FWA Ops — production env for docker-compose.yml. Copy to .env.production,
# fill in, chmod 600. Bring the stack up with:
#   docker compose --env-file .env.production up -d --build

# The public host the ops app is served at (Caddy proxies this domain). Also the
# base URL alert emails deep-link back to (APP_BASE_URL, set in docker-compose).
OPS_DOMAIN=app.franciswebagency.com

# The public host the CLIENT PORTAL is served at. REQUIRED — it has no default,
# and an empty value silently breaks things rather than erroring: it feeds
# CORS_ORIGIN, PORTAL_BASE_URL (the set-password links in portal invite emails),
# and the portal container's NUXT_PUBLIC_API_BASE.
PORTAL_DOMAIN=portal.franciswebagency.com

# The external Docker network the stack joins so the website's Caddy can reach
# it. This is the website stack's network, named after its compose project — the
# site deploys as project `website`, so it's website_default. Set it explicitly:
# docker-compose.yml still defaults to the older fwa-site_default.
PROXY_NETWORK=website_default

# MySQL root password (the DB is only reachable on the internal Docker network).
DB_ROOT_PASSWORD=change-me

# --- Public demo (the `demo` compose profile) ------------------------------
# Host the demo is served at. Its containers (api-demo/app-demo) run the same
# images against a separate `fwa_ops_demo` schema in the same mysql container,
# with every integration key unset — see docker-compose.yml. Start it with (name
# the services, or the real api/app get rebuilt and recreated alongside them):
#   docker compose --env-file .env.production --profile demo up -d --build api-demo app-demo
# The demo account is created (and the data reset) nightly by
# deploy/demo-reset.sh; visitors are signed into it automatically.
DEMO_DOMAIN=demo.franciswebagency.com
DEMO_USER_EMAIL=demo@franciswebagency.com
DEMO_USER_NAME="Alex Rivera"

# Stripe — test or live secret key. Blank disables the integration (no-ops).
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_…). Blank = incoming webhooks rejected.
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key (pk_…) — exposed to the portal for embedded Checkout.
STRIPE_PUBLISHABLE_KEY=

# PandaDoc — API key + webhook verification key. Blank disables doc generation.
PANDADOC_API_KEY=
PANDADOC_WEBHOOK_KEY=
# Template signer role names — must match the PandaDoc template exactly.
# Owner role (e.g. "Francis Web Agency") enables in-app countersign; blank = owner
# not added as a recipient. Client role defaults to "Client".
PANDADOC_OWNER_ROLE=
PANDADOC_CLIENT_ROLE=Client

# Shared secret the marketing site sends (Authorization: Bearer …) with each
# contact-form submission. Must match the site's CONTACT_FORM_WEBHOOK_SECRET.
CONTACT_FORM_WEBHOOK_SECRET=

# Resend — outgoing emails (new web inquiry, new phone inquiry, new support
# ticket, portal invite), built from published Resend templates. Blank
# RESEND_API_KEY disables email (sends no-op).
RESEND_API_KEY=
# Where internal alert emails are delivered (must be a monitored inbox).
ALERTS_EMAIL=info@franciswebagency.com
# Fallback From identity — must be on a Resend-verified domain. (Templates carry
# their own From, so this is rarely used.)
# RESEND_FROM=Francis Web Agency <info@franciswebagency.com>

# Plausible Analytics Stats API key. Blank disables the website analytics sync
# (seeded/last-synced metrics stand). Each site's domain must exist in Plausible.
PLAUSIBLE_API_KEY=
PLAUSIBLE_BASE_URL=https://plausible.io

# Google Analytics 4 — the second supported analytics provider, used by sites
# whose analytics_provider is 'ga4'. Additive to Plausible, not a replacement;
# each provider syncs independently. Credentials come from a Google service
# account with Viewer access on the GA4 property. The private key is base64'd so
# its newlines survive the env file. Blank disables GA4 sync.
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY_BASE64=

# --- Background job toggles ------------------------------------------------
# Website uptime checks hit each site's real URL — enable in production only.
# Note this gates only the LOCAL pinger; DigitalOcean managed uptime checks sync
# whenever DIGITALOCEAN_API_TOKEN is set, independently of this flag.
WEBSITE_CHECKS_ENABLED=false

# Subscription renewal reminders (bell alerts before a recurring expense hits,
# EXPENSE_REMINDER_DAYS ahead). ON unless set to exactly "false".
EXPENSE_REMINDERS_ENABLED=true

# Infrastructure alerts (site down, high CPU, low disk) polled from DigitalOcean.
# Requires DIGITALOCEAN_API_TOKEN; ON unless set to exactly "false".
DIGITALOCEAN_ALERTS_ENABLED=true

# DigitalOcean — live infrastructure panel on the website detail page (Droplet
# status, region, size, CPU/memory/disk/bandwidth). A read-only token is enough
# (scopes: droplet:read, monitoring:read). Blank disables the panel (the UI shows
# a "not connected" state). CPU/memory/disk also require the do-agent on the Droplet.
DIGITALOCEAN_API_TOKEN=
# DIGITALOCEAN_BASE_URL=https://api.digitalocean.com

# Vapi — the AI receptionist. Webhook secret authenticates server messages
# (X-Vapi-Secret); assistant id answers assistant-request; phone number is
# display-only. The demo assistant id tags marketing-site demo-line calls
# (line='demo' in the call inbox). Blank disables each piece. VAPI_API_KEY is
# the private API key — required to play call recordings (access-controlled).
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER=
VAPI_DEMO_ASSISTANT_ID=
VAPI_API_KEY=
