{
  "name": "fwa-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Francis Web Agency — internal ops API (Express + MySQL, no ORM)",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.5"
  }
}
