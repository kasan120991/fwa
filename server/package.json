{
  "name": "fwa-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Francis Web Agency — internal ops API (Express + MySQL, no ORM)",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "create-user": "node --env-file-if-exists=.env src/db/create-user.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.5",
    "socket.io": "^4.8.3",
    "stripe": "^22.3.0"
  }
}
