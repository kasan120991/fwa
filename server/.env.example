# FWA Ops API — environment
# Copy to .env and adjust. All values have safe dev defaults in src/config/env.js,
# so the server boots without this file (the DB just reports "down" until configured).

NODE_ENV=development
PORT=4000

# Where the Nuxt frontend runs (CORS allow-origin)
CORS_ORIGIN=http://localhost:3000

# File uploads (local disk storage). Defaults to server/uploads, 10 MB cap.
# UPLOADS_DIR=/absolute/path/to/uploads
# UPLOADS_MAX_BYTES=10485760

# Stripe — a customer is created when a contact becomes an active client.
# Leave blank to disable the integration (contact writes still work).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) from the Stripe dashboard or `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# PandaDoc — proposals & contracts are generated, sent, and e-signed here.
# Leave blank to disable: the records still persist locally, but no document
# is created/sent until a key is set.
PANDADOC_API_KEY=
# Shared key for verifying incoming PandaDoc webhook signatures.
PANDADOC_WEBHOOK_KEY=
# Template signer role names — must match the PandaDoc template exactly.
# Owner role (e.g. "Francis Web Agency") enables in-app countersign; leave blank
# to skip adding the owner as a recipient. Client role defaults to "Client".
PANDADOC_OWNER_ROLE=
PANDADOC_CLIENT_ROLE=Client

# Contact-form webhook — shared secret the marketing site sends as
# `Authorization: Bearer …` when posting a submission to
# /api/webhooks/contact-form. Blank = the webhook is disabled (returns 503).
CONTACT_FORM_WEBHOOK_SECRET=

# Vapi AI receptionist. VAPI_WEBHOOK_SECRET is the shared secret Vapi sends as
# `X-Vapi-Secret` on every server message to /api/webhooks/vapi — blank disables
# the webhook (returns 503). VAPI_ASSISTANT_ID is the receptionist assistant
# returned when an inbound call asks the server which assistant to use.
# VAPI_PHONE_NUMBER is display-only (shown in the receptionist header).
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER=

# DigitalOcean — live infrastructure panel on the website detail page (Droplet
# status, region, size, CPU/memory/disk/bandwidth). A read-only token is enough
# (scopes: droplet:read, monitoring:read). Blank disables the panel (the UI shows
# a "not connected" state). CPU/memory/disk also require the do-agent on the Droplet.
DIGITALOCEAN_API_TOKEN=
# DIGITALOCEAN_BASE_URL=https://api.digitalocean.com

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fwa_ops
DB_POOL_LIMIT=10
